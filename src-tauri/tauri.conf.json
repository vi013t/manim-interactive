{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "manim-interactive",
  "version": "0.1.0",
  "identifier": "com.manim-interactive.app",
  "build": {
    "beforeDevCommand": "bun run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "bun run build",
    "frontendDist": "../build"
  },
  "app": {
    "windows": [
      {
        "title": "Manim Interactive",
		"maximized": true,
		"decorations": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
		"icons/icon.ico",
		"icons/icon.png"
    ]
  }
}
